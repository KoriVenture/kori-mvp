NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Turn true only after Authentication -> Passkeys is configured in Supabase.
NEXT_PUBLIC_ENABLE_PASSKEYS=false

# Supabase Advanced MFA Phone is not available on the Free plan.
NEXT_PUBLIC_ENABLE_PHONE_MFA=false

# Public Stellar Testnet endpoints and one DealEscrow instance per demo SPV.
# These values are not secrets. Never expose a Stellar secret key to Next.js.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
